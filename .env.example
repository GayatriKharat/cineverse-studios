BASE_PATH=
CONTACT_FROM=
CONTACT_TO=
GMAIL_PASSWORD=
GMAIL_USER=
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_CONTACT_EMAIL=
RESEND_API_KEY=

# Hostinger Node.js Web App (recommended — contact form works):
# - Application type: next
# - Build command: npm run build:hostinger
# - Output directory: .next
# - Do NOT set OUTPUT_EXPORT or BASE_PATH
# - Set GMAIL_USER + GMAIL_PASSWORD (+ NEXT_PUBLIC_CONTACT_EMAIL)
#
# Hostinger shared hosting (static FTP to public_html):
# - Build: npm run build:hostinger:static
# - Upload contents of /out into public_html
# - Contact API will not run (needs Node hosting)